# Copy this file to "keystore.properties" (same folder) and fill in your
# real values. That file is gitignored and must NEVER be committed.
#
# Used only for LOCAL release builds. GitHub Actions CI does not read this
# file — it uses the KEYSTORE_BASE64 / KEYSTORE_PASSWORD / KEY_ALIAS /
# KEY_PASSWORD repository secrets instead (see .github/workflows/release.yml
# and CI_RELEASE_SETUP.md).

storeFile=/absolute/path/to/release.keystore
storePassword=CHANGE_ME
keyAlias=glassnotes
keyPassword=CHANGE_ME
