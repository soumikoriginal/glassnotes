keystore.properties

# Log/output
*.log
/build_output*
/build_final*

# OS files
.DS_Store
Thumbs.db

# Gradle wrapper jar is fetched by CI / `gradle wrapper` — keep the
# properties + scripts, but no need to track the generated jar if you
# regenerate it locally.
